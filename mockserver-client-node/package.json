  "scripts": {
    "typecheck": "tsc && tsc -p test/exports/tsconfig.node16.json && tsc -p test/exports/tsconfig.bundler.json && tsc -p ../mockserver-node/test/typescript/tsconfig.node16.json && tsc -p ../mockserver-node/test/typescript/tsconfig.bundler.json",
    "pretest": "npm run typecheck",
    "test": "node test/run_with_local_server.js",
    "test:external": "node test/run_node_tests.js",
    "test:coverage": "c8 --check-coverage --lines 84 --functions 90 --branches 80 node test/run_node_tests.js",
    "test:browser": "npx playwright test --config test/browser/playwright.config.js",
    "build:server": "cd ../mockserver && ./mvnw -q -pl mockserver-netty -am package -DskipTests"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "~26.6.1",
    "c8": "~12.0.0",
    "grunt-contrib-jshint": "~3.2.0",
    "grunt-exec": "~3.0.0",
    "js-yaml": "^4.3.2",
    "mockserver-node": "9.1.0",
    "typescript": "~7.0.2"
