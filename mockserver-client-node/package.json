    "mockServerClient.js",
    "mockServerClient.d.ts",
    "setupMockServer.js",
    "setupMockServer.d.ts",
    "sendRequest.js",
    "webSocketClient.js"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./index": {
      "types": "./index.d.ts",
      "require": "./index.js",
