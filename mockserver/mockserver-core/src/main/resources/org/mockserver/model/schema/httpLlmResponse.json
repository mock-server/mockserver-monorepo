{
  "title": "LLM response to return",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "delay": {
      "$ref": "#/definitions/delay"
    },
    "provider": {
      "type": "string",
      "enum": [
        "ANTHROPIC",
        "OPENAI",
        "OPENAI_RESPONSES",
        "GEMINI",
        "BEDROCK",
        "AZURE_OPENAI",
        "OLLAMA",
        "COHERE",
        "VOYAGE",
        "MISTRAL",
        "XAI",
        "DEEPSEEK",
        "GROQ",
        "OPENROUTER",
        "ORCAROUTER"
      ]
    },
    "model": {
      "type": "string"
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "string"
              }
            }
          }
        },
        "stopReason": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cacheCreationTokens": {
              "type": "integer",
              "minimum": 0
            },
            "reasoningTokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "streaming": {
          "type": "boolean"
        },
        "outputSchema": {
          "type": "string"
        },
        "enforceOutputSchema": {
          "type": "boolean"
        },
        "toolChoice": {
          "type": "string"
        },
        "reasoningText": {
          "type": "string"
        },
        "reasoningSignature": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "generate": {
          "type": "object",
          "additionalProperties": false,
          "description": "Request-time probabilistic generation. When set, the completion's text and streaming physics are generated per request (a declared text is ignored) and usage is computed from the generated text and the decoded request's prompt. Sampling is seeded and reproducible.",
          "properties": {
            "outputTokens": {
              "type": "object",
              "additionalProperties": false,
              "description": "Output length distribution (log-normal). Each request samples a token count, and filler text of exactly that many tokens is generated, so the reported usage.outputTokens equals the actual text length.",
              "properties": {
                "median": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Median of the distribution, in tokens.",
                  "maximum": 100000
                },
                "sigma": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Spread of the underlying normal. 0 makes the count deterministic (always the median); 0.7 puts ~2/3 of samples within [median/2, median*2]."
                },
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Lower clamp on each sample (default 1)."
                }
              }
            },
            "tokensPerSecond": {
              "type": "object",
              "additionalProperties": false,
              "description": "Streaming rate distribution (log-normal), sampled per request. Omit to leave the streaming rate at its default.",
              "properties": {
                "median": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Median streaming rate, in tokens per second (1-10000).",
                  "maximum": 10000
                },
                "sigma": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Spread of the underlying normal. 0 makes the rate deterministic."
                },
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Lower clamp on each sample (default 1)."
                }
              }
            },
            "ttft": {
              "type": "object",
              "additionalProperties": false,
              "description": "Time-to-first-token model. The delay is baseMs + msPerKiloInputTokens * (inputTokens / 1000), jittered, where inputTokens is estimated from this request's prompt - so multi-turn history growth raises TTFT like real prefill.",
              "properties": {
                "baseMs": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Fixed prefill component, in milliseconds (0 to 1,000,000; default 0).",
                  "maximum": 1000000
                },
                "msPerKiloInputTokens": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Additional milliseconds per 1000 input tokens (default 0).",
                  "maximum": 1000000
                },
                "jitter": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Relative uniform jitter applied to the computed delay (0-1, default 0)."
                }
              }
            },
            "seed": {
              "type": "integer",
              "description": "Fixed PRNG seed for reproducible generation. Omit to derive the seed from the request's method, path and body, so an identical request replays the identical generation."
            }
          }
        },
        "streamingPhysics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeToFirstToken": {
              "$ref": "#/definitions/delay"
            },
            "tokensPerSecond": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "jitter": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "seed": {
              "type": "integer"
            },
            "subwordStreaming": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "deterministicFromInput": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "rerank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topN": {
          "type": "integer",
          "minimum": 0
        },
        "deterministicFromInput": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "moderation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flaggedCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": "string"
        }
      }
    },
    "contentFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hate": {
          "type": "string"
        },
        "sexual": {
          "type": "string"
        },
        "violence": {
          "type": "string"
        },
        "selfHarm": {
          "type": "string"
        }
      }
    },
    "conversationPredicates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turnIndex": {
          "type": "integer",
          "minimum": 0
        },
        "latestMessageContains": {
          "type": "string"
        },
        "latestMessageMatches": {
          "type": "string"
        },
        "latestMessageRole": {
          "type": "string",
          "enum": [
            "USER",
            "ASSISTANT",
            "TOOL",
            "SYSTEM"
          ]
        },
        "containsToolResultFor": {
          "type": "string"
        },
        "semanticMatchAgainst": {
          "type": "string"
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collapseWhitespace": {
              "type": "boolean"
            },
            "lowercase": {
              "type": "boolean"
            },
            "sortJsonKeys": {
              "type": "boolean"
            },
            "dropBuiltInVolatileFields": {
              "type": "boolean"
            },
            "dropVolatileFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "chaos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "errorStatus": {
          "type": "integer"
        },
        "retryAfter": {
          "type": "string"
        },
        "errorProbability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "truncateMode": {
          "type": "string",
          "enum": [
            "NONE",
            "MID_STREAM"
          ]
        },
        "truncateAtFraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "malformedSse": {
          "type": "boolean"
        },
        "seed": {
          "type": "integer"
        },
        "quotaName": {
          "type": "string"
        },
        "quotaLimit": {
          "type": "integer",
          "minimum": 0
        },
        "quotaWindowMillis": {
          "type": "integer",
          "minimum": 1
        },
        "quotaErrorStatus": {
          "type": "integer"
        },
        "tokenQuotaLimit": {
          "type": "integer",
          "minimum": 1
        },
        "tokenQuotaWindowMillis": {
          "type": "integer",
          "minimum": 1
        },
        "contentFilterBlockProbability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "errorKind": {
          "type": "string"
        }
      }
    },
    "primary": {
      "type": "boolean"
    }
  },
  "definitions": {}
}
