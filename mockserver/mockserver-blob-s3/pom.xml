<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.mock-server</groupId>
        <artifactId>mockserver</artifactId>
        <version>7.6.1-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>mockserver-blob-s3</artifactId>

    <name>MockServer Blob Store - S3</name>
    <description>AWS S3 blob store backend for MockServer durable state. Implements the BlobStore SPI against the AWS SDK v2 S3Client.</description>
    <url>https://www.mock-server.com</url>

    <properties>
        <module.name>org.mockserver.blob.s3</module.name>
        <!-- AWS SDK v2: 2.31.x targets Java 8+, fully Java-17-compatible -->
        <aws.sdk.version>2.53.2</aws.sdk.version>
        <!-- The repo-wide default is ERROR, which filters MockServer's own log lines inside
             MockServerLogger before SLF4J ever sees them. S3ExpectationPersistenceReloadTest runs a
             full in-process MockServer, and the blob-store restore diagnostics it exercises are a
             WARN ("timed out after N second(s)") and an INFO ("no persisted expectations found ...
             under key"). At ERROR this Docker-gated suite would go red in CI carrying a bare
             assertion failure and no explanation of WHY the restore produced nothing. One
             in-process server across the module makes INFO cheap. -->
        <mockserver.testLogLevel>INFO</mockserver.testLogLevel>
    </properties>

    <dependencies>
        <!-- mockserver core SPI (compile scope) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-core</artifactId>
        </dependency>

        <!-- AWS SDK v2 S3 client — lives ONLY in this module -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>

        <!-- logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- netty server + java client for the end-to-end persistence reload IT -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-netty</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-client-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <!-- SLF4J provider for the tests only. S3ExpectationPersistenceReloadTest runs a full
             in-process MockServer, and MockServerLogger routes every log line through SLF4J; without
             a provider SLF4J falls back to NOP and the whole server log — including the restore
             WARN/INFO diagnostics this suite exists to exercise — is silently discarded, leaving a
             red CI run with nothing but a bare assertion failure. Version managed in the parent. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- mockserver-core test-jar for BlobStoreContract (if available), else inline -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
