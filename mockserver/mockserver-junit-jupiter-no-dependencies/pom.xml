<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.mock-server</groupId>
        <artifactId>mockserver</artifactId>
        <version>9.3.1-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>mockserver-junit-jupiter-no-dependencies</artifactId>

    <name>MockServer JUnit Jupiter Integration (No Dependencies)</name>
    <description>A JUnit5 Extension for MockServer, using the shaded mockserver-netty-no-dependencies</description>
    <url>https://www.mock-server.com</url>

    <properties>
        <module.name>org.mockserver.junit.jupiter</module.name>
    </properties>

    <dependencies>
        <!-- optional: shade bundles only this module's own classes, relocated to match the jar below,
             so consumers must not also receive the unshaded module and its transitive dependencies. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-junit-jupiter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- the shaded server, client and every relocated library this module's classes reference;
             consumers get it transitively instead of a second copy inside this jar -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-netty-no-dependencies</artifactId>
        </dependency>
        <!-- provided: JUnit Jupiter is the API this integration is written against, and the project using it
             already has it. Bundled, it clashed with the project's own copy (issue #2772). Provided is not
             passed on, so consumers inherit only mockserver-netty-no-dependencies. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- exposes ${org.mock-server:mockserver-netty-no-dependencies:jar} to assert-thin-references-resolve -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>expose-dependency-paths</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-no-dependencies</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.mock-server:mockserver-junit-jupiter</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Fail the build if a bundled dependency is left unrelocated (issue #2772); the script
                 holds the shared allow-list and why each entry stays. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>assert-only-relocated-classes</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/../mockserver-netty-no-dependencies/src/packaging/assert-only-relocated-classes.sh</executable>
                            <arguments>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- every org.mockserver / shaded_package class this jar references must be in the netty jar -->
                    <execution>
                        <id>assert-thin-references-resolve</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/../mockserver-netty-no-dependencies/src/packaging/assert-thin-references-resolve.sh</executable>
                            <arguments>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${org.mock-server:mockserver-netty-no-dependencies:jar}</argument>
                                <argument>${java.home}/bin/jdeps</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- a project depending only on this artifact uses the integration end to end -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <skipInvocation>${skipTests}</skipInvocation>
                    <streamLogs>false</streamLogs>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                    <showErrors>true</showErrors>
                    <disableReports>true</disableReports>
                    <reportsDirectory>${project.build.directory}</reportsDirectory>
                    <projectsDirectory>${basedir}/src/integration-tests/</projectsDirectory>
                    <cloneProjectsTo>${project.build.directory}/integration-tests/</cloneProjectsTo>
                    <cloneClean>true</cloneClean>
                    <ignoreFailures>false</ignoreFailures>
                    <filterProperties>
                        <mockserver.version>${project.version}</mockserver.version>
                        <maven-surefire-plugin.version>${maven-surefire-plugin.version}</maven-surefire-plugin.version>
                    </filterProperties>
                    <settingsFile>${basedir}/../mockserver-netty-no-dependencies/src/integration-tests/settings.xml</settingsFile>
                    <pomIncludes>
                        <pomInclude>maven-**/pom.xml</pomInclude>
                    </pomIncludes>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <failOnError>false</failOnError>
                    <doclint>none</doclint>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The parent pom's release profile attaches a -javadoc.jar and a
             -sources.jar, but these no-dependencies modules have no sources of
             their own, so nothing is produced and Maven Central rejects the
             deployment. Build both from the sources of the one module this jar
             shades (the parent's own-sources executions, narrowed to it). -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration>
                            <skipSource>true</skipSource>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-own-sources</id>
                                <phase>generate-resources</phase>
                                <configuration>
                                    <includeArtifactIds>mockserver-junit-jupiter</includeArtifactIds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>own-sources-jar</id>
                                <phase>prepare-package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>assert-sources-own-only</id>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <includeDependencySources>true</includeDependencySources>
                                    <dependencySourceIncludes>
                                        <dependencySourceInclude>org.mock-server:mockserver-junit-jupiter</dependencySourceInclude>
                                    </dependencySourceIncludes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
