<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.mock-server</groupId>
        <artifactId>mockserver</artifactId>
        <version>7.6.1-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>mockserver-state-infinispan</artifactId>

    <name>MockServer State Backend - Infinispan</name>
    <description>Embedded Infinispan state backend for MockServer clustered state (Phase 2b: single-node LOCAL caches)</description>
    <url>https://www.mock-server.com</url>

    <properties>
        <module.name>org.mockserver.state.infinispan</module.name>
        <!-- Infinispan 14.0.x is the last line guaranteed to run on Java 17.
             15.x targets Java 21+. Pin to 14.0.x and add a Dependabot ceiling. -->
        <infinispan.version>14.0.35.Final</infinispan.version>
    </properties>

    <!-- Pin transitive dependency versions to satisfy the enforcer dependency-convergence rule -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.logging</groupId>
                <artifactId>jboss-logging</artifactId>
                <version>3.6.3.Final</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- mockserver core SPI (compile scope — same as sibling modules) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-core</artifactId>
        </dependency>

        <!-- Infinispan embedded (NO server) — lives ONLY in this module -->
        <dependency>
            <groupId>org.infinispan</groupId>
            <artifactId>infinispan-core</artifactId>
            <version>${infinispan.version}</version>
        </dependency>

        <!-- logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- test -->
        <!-- netty server + java client for the end-to-end clustered persistence reload test -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-netty</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mockserver-client-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Opt-in assembly of the Infinispan runtime classpath (JGroups, Infinispan,
             ProtoStream, ...) the `-clustered` Docker image mounts on its /libs/*
             classpath. Activated with `-P clustered-libs`.

             WHY A PACKAGE-BOUND EXECUTION rather than a standalone
             `dependency:copy-dependencies` invocation: copy-dependencies operates on
             this project's ALREADY-RESOLVED dependency set. Bound to `package` inside
             the SAME reactor build that packages the module, the org.mock-server
             siblings (mockserver-core, ...) are resolved from the in-session reactor
             outputs — nothing is resolved against ~/.m2. A separate, later
             `-pl mockserver-state-infinispan` invocation instead starts a fresh reactor
             with no in-session siblings, so it can only resolve those SNAPSHOTs if a
             prior `install` populated ~/.m2 — which fails closed on a clean CI agent
             (the module jars are never installed by `package`). Keeping the copy in the
             build reactor removes that cross-invocation dependency entirely.

             -DincludeScope=runtime copies the compile+runtime classpath;
             -DexcludeGroupIds=org.mock-server keeps the mock-server module jars out of
             the copied set (the module jar itself is staged alongside these by the
             consumer — build_clustered_docker() / the CI image step). Inert on a normal
             build because the profile is off by default. -->
        <profile>
            <id>clustered-libs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.11.0</version>
                        <executions>
                            <execution>
                                <id>copy-clustered-runtime-libs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <excludeGroupIds>org.mock-server</excludeGroupIds>
                                    <outputDirectory>${project.build.directory}/clustered-libs</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
