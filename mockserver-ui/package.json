{
  "name": "mockserver-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "demo": "bash scripts/launch-with-demo-data.sh",
    "demo:data": "node scripts/populate-demo-data.mjs",
    "capture": "bash scripts/launch-with-llm-capture.sh",
    "screenshots": "node scripts/capture-dashboard-screenshots.mjs",
    "screenshots:all": "bash scripts/capture-docs-screenshots.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.1.2",
    "@mui/x-charts": "^9.10.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@uiw/react-json-view": "^2.0.0-alpha.43",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "posthog-js": "^1.409.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.8"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "overrides": {
    "@babel/core": "^7.29.6",
    "dompurify": "^3.4.12"
  }
}
